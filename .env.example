# Option A: Static token from Dhan dashboard
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Option B: Auth provider endpoint (auto-fetches token)
# URL of the token-service endpoint (must serve /auth/dhan/token)
DHAN_TOKEN_SERVICE_URL=
# Bearer secret for the token-service endpoint
DHAN_TOKEN_ACCESS_TOKEN=

# Option C: PIN + TOTP login (token generated, renewed, cached in ~/.dhanhq)
# Takes precedence over DHAN_ACCESS_TOKEN; ignored in DHAN_MODE=sandbox
# DHAN_PIN=
# DHAN_TOTP_SECRET=
# Absolute path; "~" is not expanded. Default: $HOME/.dhanhq
# DHAN_TOKEN_CACHE_DIR=/home/you/.dhanhq
# DHAN_TOKEN_CACHE=off

# Routing: live (default) | sandbox | hybrid
# hybrid = market data from production, execution on the Dhan sandbox
# DHAN_MODE=live
# Sandbox credentials from https://cloud.dhanhq.co (required for hybrid)
# DHAN_SANDBOX_CLIENT_ID=
# DHAN_SANDBOX_ACCESS_TOKEN=
# DHAN_SANDBOX_BASE_URL=https://sandbox.dhan.co/v2

# npm run live-check
# TEST_EXCHANGE_SEGMENT=NSE_EQ
# TEST_SECURITY_ID=1333
# TEST_ORDER_OFFSET_PCT=5
# TEST_ORDER_PRICE=
# LIVE_TRADING=true   # required to place the test order on production

# Optional overrides
# DHAN_BASE_URL=https://api.dhan.co/v2
# DHAN_PARTNER_ID=
# DHAN_PARTNER_SECRET=
